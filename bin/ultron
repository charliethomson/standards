#!/usr/bin/env bash
# ultron — read-only view of in-flight Ultron programs.
#
#   ultron ls                  list programs: task counts, what's blocked, last activity
#   ultron status [<program>]  per-task table for a program (default: the only/most recent one)
#   ultron watch [<program>]   live status, redrawn when the state changes (-n <seconds>)
#   ultron log <TASK-ID>       print a task's journal
#   ultron gc [<program>]      remove state for a fully-landed program (prompts)
#
# Reads the same state Ultron writes, so checking where a program stands costs no tokens.
# Linear is the durable record; everything here is reconstructible scratch.
set -euo pipefail

STATE_DIR="${XDG_STATE_HOME:-$HOME/.local/state}/thmsn/ultron"

c_grn=$'\033[32m'; c_yel=$'\033[33m'; c_red=$'\033[31m'; c_dim=$'\033[2m'; c_bold=$'\033[1m'; c_off=$'\033[0m'
[ -t 1 ] || { c_grn=; c_yel=; c_red=; c_dim=; c_bold=; c_off=; }

die() { printf '%serror:%s %s\n' "$c_red" "$c_off" "$*" >&2; exit 1; }

TASK_RE='[A-Z][A-Z0-9]+-[0-9]+'

# --- helpers ---------------------------------------------------------------

# mtime (epoch) of a file; 0 if absent. GNU and BSD stat take different flags, and a Mac with
# coreutils installed has GNU stat on PATH — probe once rather than guessing from the platform.
# (GNU `stat -f` means --file-system and *succeeds*, so a `||` fallback would never fire.)
if stat -c %Y . >/dev/null 2>&1; then _stat_mtime() { stat -c %Y "$1"; }
else                                 _stat_mtime() { stat -f %m "$1"; }
fi
mtime() {
  local m; m=$(_stat_mtime "$1" 2>/dev/null || true); m=${m//[!0-9]/}
  echo "${m:-0}"
}

# newest mtime anywhere under a directory
newest() {
  local newest=0 m
  while IFS= read -r f; do m=$(mtime "$f"); [ "$m" -gt "$newest" ] && newest=$m
  done < <(find "$1" -type f 2>/dev/null)
  echo "$newest"
}

# epoch -> "3m ago" / "2h ago" / "4d ago"
ago() {
  local then=$1 now delta
  [ "$then" -eq 0 ] && { echo "never"; return; }
  now=$(date +%s); delta=$((now - then))
  if   [ "$delta" -lt 60 ]    ; then echo "just now"
  elif [ "$delta" -lt 3600 ]  ; then echo "$((delta / 60))m ago"
  elif [ "$delta" -lt 86400 ] ; then echo "$((delta / 3600))h ago"
  else                              echo "$((delta / 86400))d ago"
  fi
}

program_dir() {
  local slug=$1
  [ -d "$STATE_DIR/$slug" ] || die "no such program: $slug (try 'ultron ls')"
  echo "$STATE_DIR/$slug"
}

# A cheap signature of a program's state — every file plus its mtime. Watch redraws only when
# this changes, so a quiet program doesn't flicker once a second.
fingerprint() {
  local f out=""
  while IFS= read -r f; do out+="$f:$(mtime "$f");"; done < <(find "$1" -type f 2>/dev/null | sort)
  printf '%s' "$out"
}

# programs, most-recently-touched first
list_programs() {
  [ -d "$STATE_DIR" ] || return 0
  local d
  for d in "$STATE_DIR"/*/; do
    [ -d "$d" ] || continue
    printf '%s\t%s\n' "$(newest "$d")" "$(basename "$d")"
  done | sort -rn | cut -f2
}

default_program() {
  local p; p=$(list_programs | head -1)
  [ -n "$p" ] || die "no programs under $STATE_DIR"
  echo "$p"
}

# PROGRAM.md -> "TASK<TAB>STATE<TAB>GATE" (gate is "1" for human-gated, else "").
#
# A real brief carries a task twice: once in the plan (a BACKLOG table row, no state) and again
# in a dispatch-log row that does carry one. So a task only counts as *known* when it appears as
# the first cell of a table row or at the head of a list item — that skips dependency diagrams
# and prose — and its state is read from the LAST such row, which is the dispatch log. Prose
# mentions never set state: "blocked on THM-337 landing" must not mark THM-337 blocked.
backlog() {
  local brief="$1/PROGRAM.md"
  [ -f "$brief" ] || return 0
  awk '
    # The state word nearest the task id wins, so a trailing note cannot override the declared
    # state at the front of the row.
    function firststate(s,   words, i, n, p, best, bestw) {
      n = split("landed done dispatched in-flight blocked queued", words, " ")
      best = 0
      for (i = 1; i <= n; i++) {
        p = index(s, words[i])
        if (p > 0 && (best == 0 || p < best)) { best = p; bestw = words[i] }
      }
      if (bestw == "done")      return "landed"
      if (bestw == "in-flight") return "dispatched"
      return (bestw == "") ? "" : bestw
    }
    {
      if (!match($0, /[A-Z][A-Z0-9]+-[0-9]+/)) next
      id = substr($0, RSTART, RLENGTH)
      low = tolower($0)

      # A markdown table row whose first cell is just the task id.
      isrow = 0
      if ($0 ~ /^[[:space:]]*\|/) {
        cell = $0; sub(/^[[:space:]]*\|/, "", cell); sub(/\|.*$/, "", cell)
        gsub(/[^A-Za-z0-9-]/, "", cell)
        if (cell == id) isrow = 1
      }
      # Or a list item that starts with the task id: "- THM-264 queued — ..."
      if ($0 ~ /^[[:space:]]*[-*][[:space:]]*\**[A-Z][A-Z0-9]+-[0-9]+/) isrow = 1
      # Rows only — a dependency diagram puts several tasks on one line, so reading a marker
      # from prose tags whichever task happens to come first: the M1 chain ending
      # "THM-343 (port) -> THM-342 [HUMAN]" would gate THM-341.
      if (!isrow) next

      if (low ~ /human-gated/ || $0 ~ /\[HUMAN\]/ || index($0, "🔒") > 0) gate[id] = 1

      if (!(id in seen)) { seen[id] = 1; order[++n_ids] = id }
      st = firststate(low)
      if (st != "") state[id] = st          # last row wins — the dispatch log is written last
    }
    END {
      for (i = 1; i <= n_ids; i++) {
        id = order[i]
        printf "%s\t%s\t%s\n", id, (id in state ? state[id] : "queued"), (id in gate ? "1" : "")
      }
    }' "$brief" 2>/dev/null
}

# PLAN checkbox progress in a journal -> "done/total" (empty if no checkboxes)
plan_progress() {
  local f=$1 done_n total
  [ -f "$f" ] || return 0
  done_n=$(grep -ciE '^[[:space:]-]*\[x\]' "$f" || true)
  total=$(grep -ciE '^[[:space:]-]*\[[x ]\]' "$f" || true)
  [ "${total:-0}" -gt 0 ] && echo "$done_n/$total"
}

# first meaningful line of the STATE section
state_line() {
  local f=$1
  [ -f "$f" ] || return 0
  # No \b — macOS awk is BWK awk and does not support it.
  awk '
    /^[#*>[:space:]|-]*STATE([[:space:]:|]|$)/ {
      grab = 1; sub(/^[^A-Za-z]*STATE[^A-Za-z]*/, "")
      if (length($0) > 2) { print; exit }
      next
    }
    grab && /^[#*>[:space:]|-]*(PLAN|TOUCHED|VERIFY|DECISIONS|BLOCKED)([[:space:]:|]|$)/ { exit }
    grab && NF { gsub(/^[[:space:]>*-]+/, ""); print; exit }
  ' "$f" | cut -c1-60
}

# --- commands --------------------------------------------------------------

cmd_ls() {
  local progs; progs=$(list_programs)
  [ -n "$progs" ] || { printf '%sno programs under %s%s\n' "$c_dim" "$STATE_DIR" "$c_off"; return 0; }

  printf '%s%-24s %6s %7s %7s %8s %6s  %s%s\n' \
    "$c_bold" "PROGRAM" "TASKS" "LANDED" "ACTIVE" "BLOCKED" "GATED" "LAST" "$c_off"
  local p dir rows total landed active blocked gated
  while IFS= read -r p; do
    dir="$STATE_DIR/$p"
    rows=$(backlog "$dir")
    total=$(printf '%s' "$rows" | grep -c . || true)
    landed=$(awk -F'\t' '$2 == "landed"     { n++ } END { print n + 0 }' <<< "$rows")
    active=$(awk -F'\t' '$2 == "dispatched" { n++ } END { print n + 0 }' <<< "$rows")
    blocked=$(awk -F'\t' '$2 == "blocked"   { n++ } END { print n + 0 }' <<< "$rows")
    gated=$(awk  -F'\t' '$3 == "1"          { n++ } END { print n + 0 }' <<< "$rows")
    printf '%-24s %6s %7s %7s %s%8s%s %s%6s%s  %s%s%s\n' \
      "$p" "$total" "$landed" "$active" \
      "$([ "$blocked" -gt 0 ] && printf '%s' "$c_yel")" "$blocked" "$c_off" \
      "$([ "$gated" -gt 0 ] && printf '%s' "$c_yel")" "$gated" "$c_off" \
      "$c_dim" "$(ago "$(newest "$dir")")" "$c_off"
  done <<< "$progs"
}

cmd_status() {
  local slug="${1:-$(default_program)}" dir
  dir=$(program_dir "$slug")

  printf '%s%s%s  %s%s%s\n' "$c_bold" "$slug" "$c_off" "$c_dim" "$dir" "$c_off"
  [ -f "$dir/PROGRAM.md" ] || printf '%s! no PROGRAM.md — this program has no brief%s\n' "$c_yel" "$c_off"
  echo

  local rows; rows=$(backlog "$dir")
  if [ -z "$rows" ]; then
    printf '%sno backlog lines in PROGRAM.md%s\n' "$c_dim" "$c_off"
  else
    printf '%s%-12s %-13s %6s %9s  %s%s\n' "$c_bold" "TASK" "STATE" "PLAN" "JOURNAL" "NOW" "$c_off"
    local id state gate journal colour label
    while IFS=$'\t' read -r id state gate; do
      journal="$dir/$id.md"
      case $state in
        landed)     colour=$c_grn ;;
        blocked)    colour=$c_yel ;;
        dispatched) colour=$c_bold ;;
        *)          colour=$c_dim ;;
      esac
      # printf pads by bytes, and 🔒 is four bytes wide but occupies two columns — pad by hand
      # or every gated row shifts the rest of the table left.
      label="$state"; pad=$((13 - ${#state}))
      if [ -n "$gate" ]; then
        label="$state 🔒"; pad=$((13 - ${#state} - 3))
        [ "$state" = queued ] && colour=$c_yel
      fi
      [ "$pad" -lt 1 ] && pad=1
      printf '%-12s %s%s%*s%s %6s %s%9s%s  %s\n' \
        "$id" "$colour" "$label" "$pad" "" "$c_off" \
        "$(plan_progress "$journal")" \
        "$c_dim" "$([ -f "$journal" ] && ago "$(mtime "$journal")" || echo '-')" "$c_off" \
        "$(state_line "$journal")"
    done <<< "$rows"
  fi

  # journals with no backlog line — work Ultron started but never recorded
  local orphans=""
  local f id
  for f in "$dir"/*.md; do
    [ -f "$f" ] || continue
    id=$(basename "$f" .md)
    [ "$id" = "PROGRAM" ] && continue
    grep -q "^$id	" <<< "$rows" || orphans+=" $id"
  done
  [ -n "$orphans" ] && printf '\n%s! journals with no backlog entry:%s%s\n' "$c_yel" "$orphans" "$c_off"

  # A journal for a task the ledger still calls queued means the ledger is stale — exactly the
  # discrepancy a resuming Ultron needs to notice.
  local stale; stale=$(awk -F'\t' -v d="$dir" \
    '$2 == "queued" { f = d "/" $1 ".md"; if ((getline line < f) >= 0) print $1; close(f) }' <<< "$rows" | tr '\n' ' ')
  [ -n "${stale// /}" ] && printf '\n%s! journal exists but the ledger still says queued:%s %s\n' "$c_yel" "$c_off" "$stale"

  # A gated task that already landed isn't waiting on anyone.
  local waiting; waiting=$(awk -F'\t' '$2 != "landed" && ($2 == "blocked" || $3 == "1") { print $1 }' <<< "$rows" | tr '\n' ' ')
  [ -n "${waiting// /}" ] && printf '\n%swaiting on you:%s %s\n' "$c_yel" "$c_off" "$waiting"
  return 0
}

# Interruptible sleep. bash defers a trap until the running foreground command finishes, so a
# plain `sleep 30` would swallow ctrl-c for up to 30 seconds; backgrounding it and waiting lets
# the signal land immediately.
nap() { sleep "$1" & wait $! 2>/dev/null || true; }

cmd_watch() {
  local interval=2 slug=""
  while [ $# -gt 0 ]; do
    case $1 in
      -n|--interval) interval="${2:-}"; shift 2 || die "--interval needs a value" ;;
      -*)            die "unknown option: $1" ;;
      *)             slug=$1; shift ;;
    esac
  done
  case $interval in
    ''|*[!0-9]*) die "--interval must be a whole number of seconds" ;;
  esac
  [ "$interval" -ge 1 ] || die "--interval must be at least 1 second"

  # Validate before taking over the screen, so the error is actually readable.
  [ -z "$slug" ] || program_dir "$slug" >/dev/null

  # Not a terminal (piped, redirected, in CI): print once and stop, rather than
  # spraying escape codes into whatever is reading.
  if [ ! -t 1 ]; then cmd_status "$slug"; return; fi

  printf '\033[?1049h\033[?25l'                       # alternate screen, hide cursor
  # shellcheck disable=SC2064
  trap 'printf "\033[?25h\033[?1049l"' EXIT
  trap 'exit 0' INT TERM

  local last="" sig target stamp
  while :; do
    target="$slug"
    [ -n "$target" ] || target=$(list_programs | head -1)

    if [ -z "$target" ]; then
      # No program yet — wait for one rather than erroring. Starting the watch before
      # Ultron creates the program is the normal order of operations.
      if [ "$last" != "@waiting" ]; then
        printf '\033[H\033[2J%swaiting for a program under %s …%s\n' "$c_dim" "$STATE_DIR" "$c_off"
        last="@waiting"
      fi
      nap "$interval"; continue
    fi

    sig=$(fingerprint "$STATE_DIR/$target")
    if [ "$sig" != "$last" ]; then
      stamp=$(date +%H:%M:%S)
      printf '\033[H\033[2J'
      cmd_status "$target"
      printf '\n%slast change %s · polling every %ss · ctrl-c to stop%s\n' \
        "$c_dim" "$stamp" "$interval" "$c_off"
      last="$sig"
    fi
    nap "$interval"
  done
}

cmd_log() {
  local id="${1:-}"
  [ -n "$id" ] || die "usage: ultron log <TASK-ID>"
  local hits; hits=$(find "$STATE_DIR" -name "$id.md" -type f 2>/dev/null)
  [ -n "$hits" ] || die "no journal for $id"
  local f
  while IFS= read -r f; do
    printf '%s── %s%s\n' "$c_dim" "$f" "$c_off"
    while IFS= read -r line; do printf '%s\n' "$line"; done < "$f"
  done <<< "$hits"
}

cmd_gc() {
  local slug="${1:-}"
  [ -n "$slug" ] || die "usage: ultron gc <program>   (name it explicitly — this deletes state)"
  local dir; dir=$(program_dir "$slug")

  local total landed
  total=$(backlog "$dir" | wc -l | tr -d ' ')
  landed=$(backlog "$dir" | grep -c 'landed$' || true)
  if [ "$total" -eq 0 ] || [ "$landed" -ne "$total" ]; then
    printf '%s! %s is %s/%s landed — not finished.%s\n' "$c_yel" "$slug" "$landed" "$total" "$c_off"
  fi
  printf 'delete %s ? [y/N] ' "$dir"
  local reply; read -r reply
  case $reply in
    y|Y) rm -rf "$dir"; printf '%s✓%s removed %s\n' "$c_grn" "$c_off" "$slug" ;;
    *)   echo "kept." ;;
  esac
}

# The header comment block, minus the shebang — so adding a command can't desync the help.
usage() {
  awk 'NR > 1 { if (!/^#/) exit; sub(/^#[[:space:]]?/, ""); print }' "$0"
}

case "${1:-ls}" in
  ls|list)        shift || true; cmd_ls ;;
  status|st)      shift || true; cmd_status "${1:-}" ;;
  watch|w)        shift || true; cmd_watch "$@" ;;
  log|cat)        shift || true; cmd_log "${1:-}" ;;
  gc)             shift || true; cmd_gc "${1:-}" ;;
  -h|--help|help) usage ;;
  *)              die "unknown command: $1 (try 'ultron --help')" ;;
esac
